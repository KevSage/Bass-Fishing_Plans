{
  "expo": {
    "name": "Bass Clarity",
    "slug": "bass-clarity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bassclarity",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bassclarity.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Bass Clarity needs camera access to log your catches with photos.",
        "NSPhotoLibraryUsageDescription": "Bass Clarity needs photo library access to add catch photos from your gallery.",
        "NSLocationWhenInUseUsageDescription": "Bass Clarity needs your location to find nearby lakes and generate fishing plans."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.bassclarity.app"
    },
    "plugins": [
      "expo-secure-store",
      "expo-location",
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
